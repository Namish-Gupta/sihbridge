# SIHBridge IoT/SHM Configuration
# Copy this to .env and adjust values for your environment.
# ---

# FastAPI backend REST base URL
# Development: http://localhost:8000
# LAN:         http://192.168.x.x:8000
VITE_API_BASE_URL=http://localhost:8000

# FastAPI WebSocket endpoint for real-time bridge data
# For development/local mock data:
# VITE_WS_URL=ws://localhost:8000/ws/bridge
#
# For real ESP32 (connect to FastAPI WebSocket over LAN):
# VITE_WS_URL=ws://<FASTAPI_LAPTOP_IP>:8000/ws/bridge
# Example:
# VITE_WS_URL=ws://192.168.1.105:8000/ws/bridge
VITE_WS_URL=ws://localhost:8000/ws/bridge

# Mock data mode
# "true"  = Generate simulated IoT data in the browser
# "false" = Connect to the real WebSocket endpoint above (For real ESP32)
VITE_USE_MOCK_DATA=true
